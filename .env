# Servidor
PORT=3000
NODE_ENV=development

# CORS - origem(ns) permitida(s) quando o front-end estiver em domínio separado
# Múltiplas origens separadas por vírgula. Deixe vazio para liberar tudo (não recomendado em produção).
CORS_ORIGIN=http://localhost:3000

# Google APIs
# ATENÇÃO: esta chave NUNCA deve ser exposta no front-end/HTML.
# Restrinja a chave no Console Google Cloud para: Geocoding API + Routes API,
# e restrinja por IP (o IP da sua VPS Hostinger).
GOOGLE_MAPS_API_KEY=coloque_sua_chave_aqui

# Busca de proximidade
# Quantos candidatos (mais próximos em linha reta) são enviados para a Routes API
PROXIMIDADE_CANDIDATOS=5
# Quantos resultados finais são retornados ao usuário, ordenados por tempo real
PROXIMIDADE_RESULTADOS=5

# Banco de dados
DATABASE_PATH=./data/estabelecimentos.db
