# --- Infraestrutura (Traefik / Docker Compose) ---
COMPOSE_PROJECT_NAME=localizador
SUBDOMAIN=geo
TRAEFIK_HOST=soaone.com.br

# --- Aplicação ---
PORT=3000
NODE_ENV=production

# Domínio(s) do front-end que vai consumir esta API (separados por vírgula)
CORS_ORIGIN=https://obiscoito.vercel.app

# Google Maps Platform (Geocoding API + Routes API habilitadas, com billing)
GOOGLE_MAPS_API_KEY=coloque_sua_chave_aqui

PROXIMIDADE_CANDIDATOS=5
PROXIMIDADE_RESULTADOS=5

DATABASE_PATH=data/estabelecimentos.db
